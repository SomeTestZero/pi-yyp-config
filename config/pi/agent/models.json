            "minimal": "minimal",
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": "max"
          },
          "inputLimits": {
            "images": {
              "resize": {
                "maxWidth": 2000,
                "maxHeight": 2000,
                "maxBytes": 4718592,
                "jpegQuality": 80
              }
